# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
# Never commit .env - it is gitignored.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only publishable values belong here: Vite inlines every VITE_* variable into
# the client bundle at build time, so a secret placed here ships to every visitor.

